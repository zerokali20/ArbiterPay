# ============================================
# ArbiterPay Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/arbiterpay

# --- PayPal Sandbox ---
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_webhook_id
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- PayPal Sandbox Accounts ---
# Business (client/payer — funds escrow): sb-bhnlh53339270@business.example.com
# Personal (freelancer/receiver — gets payouts): sb-okeek53339723@personal.example.com
PAYPAL_BUSINESS_EMAIL=sb-bhnlh53339270@business.example.com
PAYPAL_PERSONAL_EMAIL=sb-okeek53339723@personal.example.com

# --- AI Arbiter ---
# Optional: if no key is set, a deterministic fallback evaluator runs instead
ANTHROPIC_API_KEY=your_anthropic_api_key
ARBITER_MODEL=claude-sonnet-4-20250514
ARBITER_CONFIDENCE_THRESHOLD=0.75
ARBITER_HIGH_VALUE_THRESHOLD=500

# --- GitHub (for deliverable fetching) ---
GITHUB_TOKEN=your_github_token

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
